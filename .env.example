# LLM Configuration (OpenAI-compatible endpoint)
PROFESSIONALIZE_BASE_URL=https://your-llm-endpoint.com/v1
PROFESSIONALIZE_API_KEY_2=your-api-key-here
PROFESSIONALIZE_LLM_MODEL=your-model-name

# LinkedIn Configuration
LINKEDIN_ACCESS_TOKEN=your-linkedin-oauth-token-here
LINKEDIN_TOKEN_EXPIRES_AT=2026-07-01

# X (Twitter) Configuration — OAuth 1.0a
X_API_KEY=your-x-api-key-here
X_API_SECRET=your-x-api-secret-here
X_ACCESS_TOKEN=your-x-access-token-here
X_ACCESS_TOKEN_SECRET=your-x-access-token-secret-here

# Facebook Page Configuration
FACEBOOK_PAGE_ID=your-facebook-page-id-here
FACEBOOK_PAGE_ACCESS_TOKEN=your-facebook-page-access-token-here

# Facebook auto-renewal (see README "Facebook Token Auto-Renewal") — one app per brand
FACEBOOK_APP_ID=your-facebook-app-id-here
FACEBOOK_APP_SECRET=your-facebook-app-secret-here
FACEBOOK_USER_ACCESS_TOKEN=your-facebook-user-access-token-here

# Facebook Page Configuration — GroupDocs
FACEBOOK_GROUPDOCS_PAGE_ID=your-groupdocs-facebook-page-id-here
FACEBOOK_GROUPDOCS_PAGE_ACCESS_TOKEN=your-groupdocs-facebook-page-access-token-here
FACEBOOK_GROUPDOCS_APP_ID=your-groupdocs-facebook-app-id-here
FACEBOOK_GROUPDOCS_APP_SECRET=your-groupdocs-facebook-app-secret-here
FACEBOOK_GROUPDOCS_USER_ACCESS_TOKEN=your-groupdocs-facebook-user-access-token-here

# Metrics Configuration (Google Sheets endpoints)
METRICS_GOOGLE_SCRIPT_URL_TEAM=
METRICS_TOKEN_TEAM=
METRICS_GOOGLE_SCRIPT_URL_PROD=
METRICS_TOKEN_PROD=

# Dev.to Configuration
DEVTO_API_KEY=
DEVTO_ASPOSE_ORG_ID=

# Bluesky Configuration — one account per blog platform
# BLUESKY_{PLATFORM_ID}_HANDLE / BLUESKY_{PLATFORM_ID}_APP_PASSWORD or _PASSWORD (platform ID uppercased, - → _)
# Use an app password (Settings → Privacy and security → App passwords), not the account password
BLUESKY_ASPOSE_CLOUD_HANDLE=
BLUESKY_ASPOSE_CLOUD_PASSWORD=
BLUESKY_ASPOSE_HANDLE=
BLUESKY_ASPOSE_PASSWORD=
BLUESKY_GROUPDOCS_CLOUD_HANDLE=
BLUESKY_GROUPDOCS_CLOUD_PASSWORD=
BLUESKY_CONHOLDATE_HANDLE=
BLUESKY_CONHOLDATE_PASSWORD=

# Mastodon Configuration — one account per blog platform on mastodon.social
# MASTODON_{PLATFORM_ID}_ACCESS_TOKEN (Preferences → Development → New application;
# scopes: read:accounts, write:statuses, write:media). Tokens don't expire.
MASTODON_ASPOSE_CLOUD_ACCESS_TOKEN=
MASTODON_GROUPDOCS_CLOUD_ACCESS_TOKEN=
MASTODON_CONHOLDATE_ACCESS_TOKEN=

# Google Search Console Configuration
GSC_SERVICE_ACCOUNT_KEY_PATH=keys/your-service-account-key.json